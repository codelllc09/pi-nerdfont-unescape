{
	"name": "pi-nerdfont-unescape",
	"version": "0.2.0",
	"description": "Lossless, observable Nerd Font icon output for the Pi TUI: escape protocol, code-span protection, visible substitution, input escaping, stream drop detection, glyph lookup and layout tools",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"nerd-font",
		"unicode",
		"icons"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codelllc09/pi-nerdfont-unescape.git"
	},
	"homepage": "https://github.com/codelllc09/pi-nerdfont-unescape#readme",
	"bugs": "https://github.com/codelllc09/pi-nerdfont-unescape/issues",
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.4.0"
	},
	"pi": {
		"extensions": [
			"./nerdfont-unescape.ts"
		]
	},
	"scripts": {
		"test": "node tests/guard-layout.cjs && scripts/safe-run.sh node tests/test-nerdfont-unescape.cjs && scripts/safe-run.sh node tests/test-tools.cjs && python3 -m py_compile tests/vision-verify.py && echo 'py_compile ✓'",
		"test:audit": "node tests/guard-layout.cjs && scripts/safe-run.sh node tests/mutation-audit.cjs",
		"test:audit:light": "scripts/safe-run.sh node tests/mutation-audit.cjs --jobs 1",
		"test:raw": "node tests/test-nerdfont-unescape.cjs && node tests/test-tools.cjs",
		"guard": "node tests/guard-layout.cjs",
		"prepublishOnly": "npm test",
		"tui:probe": "scripts/tui-probe/run.sh",
		"tui:check": "CHECK=1 scripts/tui-probe/run.sh",
		"tui:pixel": "scripts/tui-probe/pixel.sh"
	},
	"files": [
		"nerdfont-unescape.ts",
		"README.md",
		"README.zh-CN.md",
		"LICENSE",
		"tests/",
		"!tests/__pycache__",
		"scripts/",
		"!scripts/tui-probe/out.png"
	],
	"engines": {
		"node": ">=22"
	},
	"author": "lcw"
}
